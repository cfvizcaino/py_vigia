{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigia.local/schemas/detection-snapshot-1.0.json",
  "title": "VIGIA Detection Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cameraId", "generatedAt", "model", "frameNumber", "detections"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "cameraId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "model": { "type": "string", "minLength": 1 },
    "frameNumber": { "type": "integer", "minimum": 0 },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trackId", "vehicleType", "confidence", "firstSeen", "lastSeen", "direction", "boundingBox", "color", "make", "model", "licensePlate"],
        "properties": {
          "trackId": { "type": "integer", "minimum": 0 },
          "vehicleType": { "enum": ["car", "motorcycle"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "firstSeen": { "type": "string", "format": "date-time" },
          "lastSeen": { "type": "string", "format": "date-time" },
          "direction": { "enum": ["izquierda-a-derecha", "derecha-a-izquierda", "arriba-a-abajo", "abajo-a-arriba", "indeterminada"] },
          "boundingBox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "integer", "minimum": 0 }
          },
          "color": { "type": ["string", "null"] },
          "make": { "type": ["string", "null"] },
          "model": { "type": ["string", "null"] },
          "licensePlate": { "type": ["string", "null"] }
        }
      }
    }
  }
}
