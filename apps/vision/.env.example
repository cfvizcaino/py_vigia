# Cuenta de cámara creada desde la aplicación Tapo.
TAPO_HOST=192.168.1.100
TAPO_USERNAME=vigia
TAPO_PASSWORD=cambiar_esta_contrasena
TAPO_STREAM=stream1

VIGIA_CAMERA_ID=CAM-01
YOLO_MODEL=yolo26n.pt
YOLO_CONFIDENCE=0.35
# Peso entrenado para una clase cuyo nombre contenga "plate". Vacío = desactivado.
PLATE_MODEL=
PLATE_CONFIDENCE=0.45
PLATE_EVERY_N_FRAMES=5
PLATE_OUTPUT=outputs/plates
DETECTION_OUTPUT=outputs/detections.json

# Publicación edge→centro. En producción usa el nombre privado de la VPN.
VIGIA_NODE_VERSION=0.2.0
VIGIA_MODEL_VERSION=yolo26n.pt
VIGIA_MODEL_DIGEST=
VIGIA_CENTRAL_API_URL=
# Credencial individual emitida para VIGIA_CAMERA_ID; ver docs/operations/device-credentials.md.
VIGIA_CENTRAL_API_TOKEN=
EVENT_OUTBOX=outputs/outbox
EVENT_QUEUE_MAX=10000
PUBLISH_TIMEOUT_SECONDS=10
