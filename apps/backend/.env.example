DATABASE_URL=sqlite:///./data/vigia.db
# Contra el Postgres de Compose: postgresql+psycopg://vigia:<VIGIA_DB_PASSWORD>@127.0.0.1:5432/vigia
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Emite un token por cámara: python -m vigia_backend.device_credentials issue --help
INGEST_AUTH_MODE=device
# Solo para migrar instalaciones anteriores: INGEST_AUTH_MODE=legacy exige un token.
INGEST_API_TOKEN=
# Vigencia de las sesiones de personas (1-24 h).
USER_SESSION_HOURS=8
# Protección ante sobrecarga, por proceso de Uvicorn (WEB_CONCURRENCY procesos).
# Peticiones simultáneas; las demás reciben 503 con Retry-After al instante.
MAX_IN_FLIGHT=20
# Conexiones a PostgreSQL y espera máxima por una (s) antes de responder 503.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
