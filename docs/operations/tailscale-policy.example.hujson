{
  "groups": {
    "group:vigia-admins": ["admin@example.com"]
  },
  "tagOwners": {
    "tag:vigia-central": ["group:vigia-admins"],
    "tag:vigia-edge": ["group:vigia-admins"]
  },
  "grants": [
    {
      "src": ["tag:vigia-edge"],
      "dst": ["tag:vigia-central"],
      "ip": ["tcp:443"]
    },
    {
      "src": ["tag:vigia-central"],
      "dst": ["tag:vigia-edge"],
      "ip": ["tcp:8443"]
    },
    {
      "src": ["group:vigia-admins"],
      "dst": ["tag:vigia-central", "tag:vigia-edge"],
      "ip": ["tcp:22", "tcp:443", "tcp:8443"]
    }
  ]
}
